# Copy this file to .env in the same folder (backend/Groupwork/) and load
# it however you prefer (django-environ, python-dotenv, or your process
# manager's env config) before running manage.py / gunicorn / daphne.
#
# Leave DB_ENGINE unset (or anything other than "postgres") to keep using
# SQLite for quick local dev with zero setup.

DB_ENGINE=postgres
DB_NAME=groupwork
DB_USER=groupwork
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# ── Production-only settings ────────────────────────────────────────────
# Safe to leave unset for local dev — each one falls back to the same
# permissive defaults you're already using. Set these once you deploy
# somewhere public. settings.py refuses to boot if DEBUG=False is set
# without ALLOWED_HOSTS, or CORS_ALLOW_ALL_ORIGINS=False without
# CORS_ALLOWED_ORIGINS — misconfigured prod fails loudly at startup
# instead of silently serving broken/insecure responses.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=False
ALLOWED_HOSTS=your-domain.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Only relevant if you're NOT already behind a proxy/PaaS that terminates
# TLS and redirects http->https for you.
SECURE_SSL_REDIRECT=True
