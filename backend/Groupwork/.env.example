# Copy this file to .env in the same folder (backend/Groupwork/) and load
# it however you prefer (django-environ, python-dotenv, or your process
# manager's env config) before running manage.py / gunicorn / daphne.
#
# Leave DB_ENGINE unset (or anything other than "postgres") to keep using
# SQLite for quick local dev with zero setup.

DB_ENGINE=postgres
DB_NAME=groupwork
DB_USER=groupwork
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
