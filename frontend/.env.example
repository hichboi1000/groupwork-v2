# Copy this file to .env and adjust for your setup.
# Vite only exposes variables prefixed with VITE_ to the browser.

# The Django backend's base URL. For phone/LAN testing, replace
# localhost with your computer's LAN IP (e.g. http://192.168.1.42:8000)
# so a phone on the same wifi can reach it.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000
